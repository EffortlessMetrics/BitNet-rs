{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BitNet Inference API v1",
  "version": "1.0.0",
  "description": "Contract for BitNet inference API endpoints and data structures",

  "definitions": {
    "ModelConfig": {
      "type": "object",
      "required": ["model_type", "hidden_size", "num_layers", "vocab_size"],
      "properties": {
        "model_type": {
          "type": "string",
          "enum": ["bitnet_b158", "bitnet_3b", "custom"]
        },
        "hidden_size": {
          "type": "integer",
          "minimum": 128,
          "maximum": 16384
        },
        "num_layers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "vocab_size": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 256000
        },
        "intermediate_size": {
          "type": "integer",
          "minimum": 256
        },
        "num_attention_heads": {
          "type": "integer",
          "minimum": 1
        },
        "quantization": {
          "type": "string",
          "enum": ["i2_s", "tl1", "tl2"],
          "default": "i2_s"
        }
      }
    },

    "InferenceRequest": {
      "type": "object",
      "required": ["prompt"],
      "properties": {
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096,
          "default": 256
        },
        "temperature": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 2.0,
          "default": 1.0
        },
        "top_p": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 1.0
        },
        "top_k": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000,
          "default": 50
        },
        "stream": {
          "type": "boolean",
          "default": false
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },

    "InferenceResponse": {
      "type": "object",
      "required": ["id", "choices", "usage", "model", "created"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9-]+$"
        },
        "choices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/Choice"
          }
        },
        "usage": {
          "$ref": "#/definitions/Usage"
        },
        "model": {
          "type": "string"
        },
        "created": {
          "type": "integer",
          "minimum": 0
        }
      }
    },

    "Choice": {
      "type": "object",
      "required": ["index", "text", "finish_reason"],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "text": {
          "type": "string"
        },
        "finish_reason": {
          "type": "string",
          "enum": ["stop", "length", "error", null]
        },
        "logprobs": {
          "type": ["object", "null"]
        }
      }
    },

    "Usage": {
      "type": "object",
      "required": ["prompt_tokens", "completion_tokens", "total_tokens"],
      "properties": {
        "prompt_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "completion_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0
        }
      }
    },

    "StreamChunk": {
      "type": "object",
      "required": ["id", "choices", "created"],
      "properties": {
        "id": {
          "type": "string"
        },
        "choices": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "index": {
                "type": "integer"
              },
              "delta": {
                "type": "object",
                "properties": {
                  "content": {
                    "type": "string"
                  }
                }
              },
              "finish_reason": {
                "type": ["string", "null"]
              }
            }
          }
        },
        "created": {
          "type": "integer"
        }
      }
    },

    "ChatCompletionResponseMetadata": {
      "type": "object",
      "required": [
        "receipt_id",
        "receipt_path",
        "latest_receipt_path",
        "readiness_path",
        "selected_backend",
        "selected_route",
        "fallback_used"
      ],
      "properties": {
        "receipt_id": {
          "type": "string"
        },
        "receipt_path": {
          "type": "string",
          "pattern": "^/receipts/[A-Za-z0-9_-]+$"
        },
        "latest_receipt_path": {
          "type": "string",
          "const": "/receipts/latest"
        },
        "readiness_path": {
          "type": "string",
          "const": "/readiness"
        },
        "model_coverage_row": {
          "type": ["string", "null"]
        },
        "model_coverage_tier": {
          "type": ["string", "null"]
        },
        "selected_backend": {
          "type": "string"
        },
        "selected_route": {
          "type": "string"
        },
        "fallback_used": {
          "type": "boolean"
        }
      }
    },

    "ServerSharedEngineReceipt": {
      "type": "object",
      "required": [
        "receipt_kind",
        "request_id",
        "runtime_path",
        "runtime_api",
        "requested_model",
        "active_model_id",
        "selected_backend",
        "requested_backend",
        "selected_route",
        "fallback_used",
        "server_ready_claimed",
        "speedup_claim",
        "full_cuda_residency_claimed"
      ],
      "properties": {
        "receipt_kind": {
          "type": "string",
          "const": "server_shared_engine_chat_completion"
        },
        "request_id": {
          "type": "string"
        },
        "runtime_path": {
          "type": "string",
          "const": "shared_local_inference_engine"
        },
        "runtime_api": {
          "type": "string"
        },
        "model_coverage_row": {
          "type": ["string", "null"]
        },
        "model_coverage_tier": {
          "type": ["string", "null"]
        },
        "selected_backend": {
          "type": "string"
        },
        "requested_backend": {
          "type": "string"
        },
        "selected_route": {
          "type": "string"
        },
        "fallback_used": {
          "type": "boolean"
        },
        "server_smoke_response_claimed": {
          "type": "boolean"
        },
        "server_ready_claimed": {
          "type": "boolean",
          "const": false
        },
        "speedup_claim": {
          "type": "boolean",
          "const": false
        },
        "full_cuda_residency_claimed": {
          "type": "boolean",
          "const": false
        }
      }
    },

    "ServerReceiptLookupError": {
      "type": "object",
      "required": ["error_code", "error", "receipt_id"],
      "properties": {
        "error_code": {
          "type": "string",
          "enum": ["NO_RECEIPTS", "INVALID_RECEIPT_ID", "RECEIPT_NOT_FOUND"]
        },
        "error": {
          "type": "string"
        },
        "receipt_id": {
          "type": ["string", "null"]
        }
      }
    },

    "ServerReadinessResponse": {
      "type": "object",
      "required": ["ready", "status", "model", "backend", "inference", "claim_boundary"],
      "properties": {
        "ready": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": ["ready", "not_ready"]
        },
        "model": {
          "type": "object",
          "properties": {
            "active_model": {
              "type": ["object", "null"],
              "properties": {
                "model_coverage_row": {
                  "type": ["string", "null"]
                },
                "model_coverage_tier": {
                  "type": ["string", "null"]
                },
                "selected_route": {
                  "type": ["string", "null"]
                }
              }
            }
          }
        },
        "backend": {
          "type": "object"
        },
        "inference": {
          "type": "object"
        },
        "claim_boundary": {
          "type": "object",
          "properties": {
            "server_ready_claimed": {
              "type": "boolean",
              "const": false
            },
            "speedup_claim": {
              "type": "boolean",
              "const": false
            },
            "full_cuda_residency_claimed": {
              "type": "boolean",
              "const": false
            }
          }
        }
      }
    },

    "Error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "invalid_request",
            "model_not_found",
            "rate_limit_exceeded",
            "internal_error",
            "out_of_memory",
            "unsupported_feature"
          ]
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "object"
        }
      }
    }
  },

  "endpoints": {
    "/v1/models": {
      "GET": {
        "description": "List available models",
        "response": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ModelConfig"
          }
        }
      }
    },
    "/readiness": {
      "GET": {
        "description": "Server readiness and claim-boundary state with active model coverage linkage when available",
        "response": {
          "$ref": "#/definitions/ServerReadinessResponse"
        }
      }
    },
    "/v1/readiness": {
      "GET": {
        "description": "Versioned alias for server readiness and claim-boundary state",
        "response": {
          "$ref": "#/definitions/ServerReadinessResponse"
        }
      }
    },
    "/receipts/latest": {
      "GET": {
        "description": "Return the latest in-memory server shared-engine receipt",
        "response": {
          "$ref": "#/definitions/ServerSharedEngineReceipt"
        },
        "errors": {
          "$ref": "#/definitions/ServerReceiptLookupError"
        }
      }
    },
    "/receipts/{receipt_id}": {
      "GET": {
        "description": "Return a captured server shared-engine receipt by request/receipt id",
        "parameters": {
          "receipt_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          }
        },
        "response": {
          "$ref": "#/definitions/ServerSharedEngineReceipt"
        },
        "errors": {
          "$ref": "#/definitions/ServerReceiptLookupError"
        }
      }
    },
    "/v1/chat/completions": {
      "POST": {
        "description": "OpenAI-compatible non-streaming chat completion with receipt metadata and embedded server receipt",
        "response": {
          "type": "object",
          "required": ["id", "object", "created", "model", "choices", "usage", "metadata", "receipt"],
          "properties": {
            "metadata": {
              "$ref": "#/definitions/ChatCompletionResponseMetadata"
            },
            "receipt": {
              "$ref": "#/definitions/ServerSharedEngineReceipt"
            }
          }
        },
        "errors": {
          "$ref": "#/definitions/Error"
        }
      }
    },
    "/v1/completions": {
      "POST": {
        "description": "Generate text completion",
        "request": {
          "$ref": "#/definitions/InferenceRequest"
        },
        "response": {
          "$ref": "#/definitions/InferenceResponse"
        },
        "errors": {
          "$ref": "#/definitions/Error"
        }
      }
    }
  }
}
