+static int bitnet_rs_reference_layer_trace_requested_layer() {
+    const char * env = std::getenv("BITNET_RS_REFERENCE_LAYER_TRACE_LAYER");
+    if (env == nullptr || env[0] == '\0') {
+        return 0;
+    }
+    int parsed = 0;
+    for (const char * p = env; *p != '\0'; ++p) {
+        if (*p < '0' || *p > '9') {
+            return 0;
+        }
+        parsed = parsed * 10 + (*p - '0');
+    }
+    return parsed;
+}
