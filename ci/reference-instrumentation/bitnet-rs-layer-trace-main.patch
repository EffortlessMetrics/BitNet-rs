+static int bitnet_rs_reference_layer_trace_layer(const char * name) {
+    const char * dash = strrchr(name, '-');
+    if (dash != nullptr && dash[1] != '\0') {
+        int layer = 0;
+        for (const char * p = dash + 1; *p != '\0'; ++p) {
+            if (*p < '0' || *p > '9') {
+                return -1;
+            }
+            layer = layer * 10 + (*p - '0');
+        }
+        return layer;
+    }
+    return -1;
+}
