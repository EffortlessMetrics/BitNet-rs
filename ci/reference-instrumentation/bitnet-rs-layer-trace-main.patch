+static int bitnet_rs_reference_layer_trace_layer(const char * name) {
+    const size_t len = strlen(name);
+    if (len >= 2 && name[len - 2] == '-' && name[len - 1] == '0') {
+        return 0;
+    }
+    return -1;
+}
